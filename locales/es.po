msgstr "Hacer que las fichas de daño / horror sean clickeables"

# Tooltip: Make damage / horror tokens clickable
msgid "OP_makeDamageHorrorClickable_tooltip"
msgstr ""
"Hace que las fichas de daño y horror sean clickeables\n"
"(además de poder introducir números al escribir)."

# Option: Show '1' on damage / horror tokens
msgid "OP_showOneDamageHorror"
msgstr "Mostrar un 1 en fichas de daño / horror"

# Tooltip: Show '1' on damage / horror tokens
