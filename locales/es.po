# Option: UI language
msgid "OP_uiLanguage"
msgstr "Idioma de la interfaz"

# Tooltip: UI language
msgid "OP_uiLanguage_tooltip"
msgstr ""
"Establece el idioma para los elementos de la interfaz\n"
"como este panel de opciones."

# Option: set default difficulty to Hard/Expert
msgid "OP_defaultHardExpert"
msgstr "Establece dificultad Difícil/Experto"

# Tooltip: set default difficulty to Hard/Expert
msgid "OP_defaultHardExpert_tooltip"
msgstr ""
"Establece la carta de referencia de escenario\n"
"a Difícil/Experto por defecto."

# Option: splash scenario name on setup
msgid "OP_showTitleSplash"
msgstr "Mostrar título del escenario al preparar"

# Tooltip: splash scenario name on setup
msgid "OP_showTitleSplash_tooltip"
msgstr ""
"Muestra el nombre del escenario durante 2 segundos\n"
"al prepararlo."

# Option: splash token on draw
msgid "OP_showTokenSplash"
msgstr "Mostrar ficha ampliada en pantalla"

# Tooltip: splash token on draw
msgid "OP_showTokenSplash_tooltip"
msgstr ""
"Muestra una versión grande de la ficha robada\n"
"durante 2 segundos."

# Option: Enable all card helpers
msgid "OP_enableCardHelpers"
msgstr "Activar todas las ayudas de cartas"

# Tooltip: Enable all card helpers
msgid "OP_enableCardHelpers_tooltip"
msgstr ""
"Activa todas las ayudas de cartas (generalmente activadas a través del menú contextual).\n"
"Ejemplos: Acuerdo Falso y Libro de los Mitos Vivientes"

# Option: Make damage / horror tokens clickable
