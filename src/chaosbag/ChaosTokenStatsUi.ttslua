            resizeTextForBestFit = true,
            resizeTextMaxSize    = 36,
            font                 = fontName,
            color                = "White",
            preferredHeight      = 46,
            alignment            = "Middle"
          }
        },
        {
          tag = "HorizontalLayout",
          attributes = {
            preferredHeight = 30,
            width           = 800,
            spacing         = 8
          },
          children = {
            {
              tag = "Text",
              attributes = {
                id                   = "CT_scope_label",
                text                 = i18nApi.getStrById("CT_scope_label"),
                preferredWidth       = 70,
                resizeTextForBestFit = true,
