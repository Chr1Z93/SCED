    local tokenId = createChaosTokenNameLookupTable()[tokenName] or "custom-token"
    return {
      tag = "VerticalLayout",
      attributes = {
        id              = "chaosStatCol_" .. uiId,
        active          = false,
        width           = 32,
        preferredHeight = 230,
        spacing         = 4
      },
      children = {
        {
          tag = "Text",
          attributes = {
            id              = "chaosStatCount_" .. uiId,
            text            = "0",
            color           = "White",
            alignment       = "MiddleCenter",
            fontSize        = 18,
            preferredHeight = 20
          }
        },
        {
          tag = "VerticalLayout",
          attributes = {
            preferredHeight = 180,
            color           = "#1C1C1C",
            padding         = "0 0 0 0"
          },
          children = {
            {
              tag = "Panel",
              attributes = {
                id              = "chaosStatSpacer_" .. uiId,
                preferredHeight = 1
              }
            },
            {
              tag = "Panel",
              attributes = {
                id              = "chaosStatBar_" .. uiId,
                preferredHeight = 0,
                color           = "#6FA8DC"
              }
            }
          }
        },
        {
          tag = "HorizontalLayout",
          attributes = {
            preferredHeight = 24,
            childAlignment  = "UpperCenter"
          },
          children = {
            {
              tag = "Image",
              attributes = {
                id              = "chaosStatLabelSymbol_" .. uiId,
                image           = "token-" .. tokenId,
                preserveAspect  = true,
                preferredWidth  = 24,
                preferredHeight = 24
              }
            }
          }
        }
      }
    }
  end

  local function makeLast5TokenContainer(i)
    return {
      tag = "Panel",
      attributes = {
        id              = "chaosStatLastFiveSlot_" .. i,
        active          = false,
        preferredWidth  = 28,
        preferredHeight = 28
      },
      children = {
        {
          tag = "Image",
          attributes = {
            id              = "chaosStatLastFiveImage_" .. i,
            active          = false,
            preserveAspect  = true,
            preferredWidth  = 28,
            preferredHeight = 28
          }
        }
      }
    }
  end

