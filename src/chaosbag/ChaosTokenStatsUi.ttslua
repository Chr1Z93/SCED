    return {
      tag = "VerticalLayout",
      attributes = {
        id                                   = "chaosStatTrackerWindow",
        active                               = false,
        color                                = "Black",
        width                                = 850,
        height                               = 560,
        padding                              = "20 20 10 10",
        spacing                              = 10,
        outlineSize                          = "2 2",
        outline                              = "#303030",
        allowDragging                        = true,
        returnToOriginalPositionWhenReleased = false,
        showAnimation                        = "Grow",
        hideAnimation                        = "Shrink",
        showAnimationDelay                   = 0.25,
        hideAnimationDelay                   = 0,
        animationDuration                    = 0.5
      },
      children = {
        {
          tag = "Text",
          attributes = {
            id                   = "CT_title",
