                resizeTextMaxSize    = 20,
                scrollSensitivity    = 20,
                font                 = fontName,
                onValueChanged       = "onChaosStatTokenFilterDropdownChanged(selectedIndex)"
              },
              children = filterOptions
            },
            {
              tag = "Button",
              attributes = {
                id                   = "CT_button_reset",
                text                 = i18nApi.getStrById("CT_button_reset"),
                onClick              = "resetChaosTokenStatTracker",
                preferredWidth       = 170,
                resizeTextForBestFit = true,
                resizeTextMaxSize    = 20,
                font                 = fontName,
                color                = "#996666"
              }
            }
          }
        },
        {
          tag = "HorizontalLayout",
          attributes = {
            preferredHeight = 40,
            width           = 800,
            spacing         = 6
          },
          children = {
            {
              tag = "Text",
              attributes = {
                id                   = "CT_tokens_drawn_text",
                text                 = "",
                resizeTextForBestFit = true,
                resizeTextMaxSize    = 24,
                font                 = fontName,
                color                = "#CCCCCC",
                alignment            = "MiddleLeft",
                preferredHeight      = 34,
                preferredWidth       = 280
              }
            },
            { tag = "Panel", attributes = { flexibleWidth = 1000 } },
            {
              tag = "HorizontalLayout",
              attributes = {
                preferredHeight = 30,
