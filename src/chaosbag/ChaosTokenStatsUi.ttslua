                            preferredHeight = 10,
                            fontSize        = 9
                          }
                        },
                        { tag = "Panel", attributes = { flexibleWidth = 1000 } },
                        {
                          tag = "Text",
                          attributes = {
                            id              = "CT_last_five_newest_marker",
                            active          = false,
                            text            = i18nApi.getStrById("CT_last_five_newest_marker"),
                            color           = "#646464ee",
