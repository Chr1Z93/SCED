                color                = "#888888",
                preferredWidth       = 100,
                height               = 35
              }
            }
          }
        }
      }
    }
  end

  function ChaosTokenStatsUi.renderChaosStatTrackerUi()
    local scopeOptions = ChaosTokenStatsUi.getChaosStatScopeOptions()
    local hasSelectedScope = false
    for _, option in ipairs(scopeOptions) do
      if option.key == chaosStatSelectedScope then
        hasSelectedScope = true
        break
      end
    end
    if not hasSelectedScope then
      chaosStatSelectedScope = "Overall"
    end

    ChaosTokenStatsUi.updateChaosStatScopeDropdown(scopeOptions)

    local scopeStats = tokenDrawingStats[chaosStatSelectedScope] or {}
    local totalCount = 0
    for _, count in pairs(scopeStats) do
      totalCount = totalCount + math.max(0, count or 0)
    end

    local allTokenNames = ChaosTokenStatsUi.getChaosStatTokenOrder()
    local tokenNames    = ChaosTokenStatsUi.getChaosStatVisibleTokenOrder(scopeStats)
    local maxCount      = 0
    local maxBarHeight  = 180

    for _, tokenName in ipairs(tokenNames) do
      local count = math.max(0, scopeStats[tokenName] or 0)
      if count > maxCount then
        maxCount = count
      end
    end

    for _, tokenName in ipairs(allTokenNames) do
      local uiId = ChaosTokenStatsUi.getChaosStatTokenUiId(tokenName)
      UI.setAttribute("chaosStatCol_" .. uiId, "active", false)
      UI.setAttribute("chaosStatCount_" .. uiId, "text", 0)
      UI.setAttribute("chaosStatSpacer_" .. uiId, "preferredHeight", maxBarHeight)
      UI.setAttribute("chaosStatBar_" .. uiId, "preferredHeight", 0)
    end

    for _, tokenName in ipairs(tokenNames) do
      local count        = math.max(0, scopeStats[tokenName] or 0)
      local barHeight    = 0
      local spacerHeight = maxBarHeight
      if maxCount > 0 and count > 0 then
        barHeight = math.floor((count / maxCount) * maxBarHeight + 0.5)
        spacerHeight = math.max(0, maxBarHeight - barHeight)
      end

      local uiId = ChaosTokenStatsUi.getChaosStatTokenUiId(tokenName)
      UI.setAttribute("chaosStatCol_" .. uiId, "active", true)
      UI.setAttribute("chaosStatCount_" .. uiId, "text", count)
      UI.setAttribute("chaosStatSpacer_" .. uiId, "preferredHeight", spacerHeight)
      UI.setAttribute("chaosStatBar_" .. uiId, "preferredHeight", barHeight)
    end

    local filterIndex = 0
    for i, filterOption in ipairs(CHAOS_STAT_FILTER_OPTIONS) do
      if filterOption.key == chaosStatTokenFilterMode then
        filterIndex = i - 1
        break
      end
    end
    UI.setAttribute("chaosStatTokenFilterDropdown", "value", filterIndex)

    local lastFiveTokens = ChaosTokenStatsUi.getChaosStatLastFiveForScope(chaosStatSelectedScope)
    local hasLastFive    = #lastFiveTokens > 0
    UI.setAttribute("CT_last_five_label", "text", hasLastFive and i18nApi.getStrById("CT_last_five_label") or "")
    UI.setAttribute("CT_last_five_newest_marker", "active", hasLastFive)
    UI.setAttribute("CT_last_five_oldest_marker", "active", hasLastFive)
    local tokenNameLookup = createChaosTokenNameLookupTable()

    for i = 1, 5 do
      local tokenName   = lastFiveTokens[i]
      local slotImageId = "chaosStatLastFiveImage_" .. i
      local slotPanelId = "chaosStatLastFiveSlot_" .. i

      if tokenName then
        local tokenId = tokenNameLookup[tokenName] or "custom-token"
        UI.setAttribute(slotPanelId, "active", true)
        UI.setAttribute(slotImageId, "active", true)
        UI.setAttribute(slotImageId, "image", "token-" .. tokenId)
      else
        UI.setAttribute(slotPanelId, "active", false)
        UI.setAttribute(slotImageId, "active", false)
      end
    end

    UI.setAttribute("CT_title", "text", i18nApi.getStrById("CT_title"))
    UI.setAttribute("CT_tokens_drawn_text", "text", i18nApi.getStrById("CT_tokens_drawn_text") .. ": " .. totalCount)
  end

  return ChaosTokenStatsUi
end
