                {
                  tag = "Text",
                  attributes = {
                    id                   = "CT_last_five_label",
                    text                 = i18nApi.getStrById("CT_last_five_label"),
                    color                = "#BBBBBB",
                    alignment            = "MiddleRight",
                    preferredWidth       = 64,
                    preferredHeight      = 34,
                    resizeTextForBestFit = true,
                    resizeTextMaxSize    = 16,
                    font                 = fontName
                  }
                },
                {
                  tag = "VerticalLayout",
