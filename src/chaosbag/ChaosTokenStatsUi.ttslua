do
  local ChaosTokenStatsUi = {}
  local PlayermatApi = require("playermat/PlayermatApi")

  local tokenDrawingStats = { ["Overall"] = {} }
  local lastDrawnTokens = { ["Overall"] = {} }
  local chaosStatSelectedScope = "Overall"
  local chaosStatTokenFilterMode = "inBag"
  local chaosStatScopeOptionKeys = { "Overall" }
  local chaosStatScopeOptionsSig = ""

  local CHAOS_STAT_TOKEN_ORDER = {
    "Elder Sign", "+1", "0", "-1", "-2", "-3", "-4", "-5",
    "-6", "-7", "-8", "Skull", "Cultist", "Tablet", "Elder Thing",
    "Auto-fail", "Bless", "Curse", "Frost", "Blood", "Custom Token"
  }

  local CHAOS_STAT_FILTER_OPTIONS = {
    { key = "inBag", label = "Tokens In Bag" },
    { key = "symbols", label = "Symbol Tokens" },
    { key = "all", label = "All Tokens" }
  }

  local CHAOS_STAT_SYMBOL_TOKEN_SET = {
    ["Auto-fail"] = true,
    ["Elder Sign"] = true,
    ["Skull"] = true,
    ["Cultist"] = true,
    ["Tablet"] = true,
    ["Elder Thing"] = true,
    ["Bless"] = true,
    ["Curse"] = true,
    ["Frost"] = true,
    ["Blood"] = true,
    ["Custom Token"] = true
  }

  local function assertChaosStatDataSources()
    if type(tokenDrawingStats) ~= "table" or type(lastDrawnTokens) ~= "table" then
      error("ChaosTokenStatsUi data sources are not initialized")
    end
  end

  function ChaosTokenStatsUi.setChaosStatDataSources(stats, history)
    if type(stats) ~= "table" or type(history) ~= "table" then
      error("ChaosTokenStatsUi.setChaosStatDataSources expects table sources")
    end

    tokenDrawingStats = stats
    lastDrawnTokens = history
  end

  function ChaosTokenStatsUi.resetChaosStatTrackerUiState()
    chaosStatSelectedScope = "Overall"
    chaosStatTokenFilterMode = "inBag"
    chaosStatScopeOptionKeys = { "Overall" }
    chaosStatScopeOptionsSig = ""
  end

  function ChaosTokenStatsUi.getChaosStatScopeOptions()
    assertChaosStatDataSources()

    local options = {
      { key = "Overall", label = "Overall" }
    }
    local others = {}
    for key, stats in pairs(tokenDrawingStats) do
      if key ~= "Overall" then
        local hasData = false
        for _, count in pairs(stats or {}) do
          if (count or 0) > 0 then
            hasData = true
            break
          end
        end
        if hasData then
          table.insert(others, {
            key = key,
            label = getDisplayName(key)
          })
        end
      end
    end

    table.sort(others, function(a, b)
      return string.lower(a.label) < string.lower(b.label)
    end)

    for _, option in ipairs(others) do
      table.insert(options, option)
    end

    return options
  end

  function ChaosTokenStatsUi.updateChaosStatScopeDropdown(scopeOptions)
    local labels = {}
    chaosStatScopeOptionKeys = {}

    for i, option in ipairs(scopeOptions) do
      labels[i] = option.label
      chaosStatScopeOptionKeys[i] = option.key
    end

    local signature = table.concat(chaosStatScopeOptionKeys, "|") .. "::" .. table.concat(labels, "|")

    if chaosStatScopeOptionsSig ~= signature then
      local globalXml = Global.UI.getXmlTable() or {}
      local dropdown = getXmlTableElementById(globalXml, "chaosStatScopeDropdown")
      if dropdown then
        dropdown.children = {}
        for _, label in ipairs(labels) do
          table.insert(dropdown.children, { tag = "Option", value = label })
        end
        updateGlobalXml(globalXml)
      end
      chaosStatScopeOptionsSig = signature
    end

    local selectedIndex = 0
    for i, key in ipairs(chaosStatScopeOptionKeys) do
      if key == chaosStatSelectedScope then
        selectedIndex = i - 1
        break
      end
    end
    UI.setAttribute("chaosStatScopeDropdown", "value", selectedIndex)
  end

  function ChaosTokenStatsUi.setChaosStatScopeFromClick(player, clickType)
    if clickType == "-2" then
      return
    end

    if clickType ~= "-3" then
      chaosStatSelectedScope = "Overall"
      return
    end

    if not player then
      chaosStatSelectedScope = "Overall"
      return
    end

    local matColor = PlayermatApi.getMatColor(player.color)
    if matColor then
      chaosStatSelectedScope = matColor
    else
      chaosStatSelectedScope = "Overall"
    end
  end

  function ChaosTokenStatsUi.onChaosStatScopeDropdownChanged(_, selectedIndex)
    local numericIndex = tonumber(selectedIndex)
    if numericIndex == nil then return end
    local index = numericIndex + 1
    local scopeKey = chaosStatScopeOptionKeys[index]
    if scopeKey == nil then return end
    chaosStatSelectedScope = scopeKey
    ChaosTokenStatsUi.renderChaosStatTrackerUi()
  end

  function ChaosTokenStatsUi.onChaosStatTokenFilterDropdownChanged(_, selectedIndex)
    local numericIndex = tonumber(selectedIndex)
    if numericIndex == nil then return end
    local index = numericIndex + 1
    local selectedOption = CHAOS_STAT_FILTER_OPTIONS[index]
    if not selectedOption then return end
    chaosStatTokenFilterMode = selectedOption.key
    ChaosTokenStatsUi.renderChaosStatTrackerUi()
  end

  function ChaosTokenStatsUi.onClick_chaosStatResetTokenStats(player, _, _)
    if not player then return end
    resetChaosTokenStatTracker(player, true)
  end

  function ChaosTokenStatsUi.getChaosStatTokenUiId(tokenName)
    return tokenName
        :gsub("%+", "plus_")
        :gsub("%-", "minus_")
        :gsub("[^%w]", "_")
  end

  function ChaosTokenStatsUi.getChaosStatTokenOrder()
    local tokenNames = {}
    local seen = {}

    for _, tokenName in ipairs(CHAOS_STAT_TOKEN_ORDER) do
      if not seen[tokenName] then
        table.insert(tokenNames, tokenName)
        seen[tokenName] = true
      end
    end

    for _, tokenData in pairs(ID_URL_MAP) do
      if tokenData and tokenData.name and not seen[tokenData.name] then
        table.insert(tokenNames, tokenData.name)
        seen[tokenData.name] = true
      end
    end

    local customTokenName = getReadableTokenName("")
    if not seen[customTokenName] then
      table.insert(tokenNames, customTokenName)
    end

    return tokenNames
  end

  function ChaosTokenStatsUi.getChaosStatTokenNamesInBag()
    local tokenNameSet = {}
    local chaosBag = findChaosBag()
    if not chaosBag then return nil end

    for _, tokenId in ipairs(getChaosBagState()) do
      local tokenData = ID_URL_MAP[tokenId]
      if tokenData and tokenData.name then
        tokenNameSet[tokenData.name] = true
      end
    end

    return tokenNameSet
  end

  function ChaosTokenStatsUi.isChaosStatSymbolToken(tokenName)
    return CHAOS_STAT_SYMBOL_TOKEN_SET[tokenName] == true
  end

  function ChaosTokenStatsUi.getChaosStatVisibleTokenOrder(scopeStats)
    local tokenNames = ChaosTokenStatsUi.getChaosStatTokenOrder()
    if chaosStatTokenFilterMode == "all" then
      return tokenNames
    end

    local visibleTokenNames = {}
    local inBag = nil
    if chaosStatTokenFilterMode == "inBag" then
      inBag = ChaosTokenStatsUi.getChaosStatTokenNamesInBag()
      if not inBag then
        return tokenNames
      end
    end

    for _, tokenName in ipairs(tokenNames) do
      if chaosStatTokenFilterMode == "inBag" and inBag[tokenName] then
        table.insert(visibleTokenNames, tokenName)
      elseif chaosStatTokenFilterMode == "symbols" and ChaosTokenStatsUi.isChaosStatSymbolToken(tokenName) then
        table.insert(visibleTokenNames, tokenName)
      end
    end

    if #visibleTokenNames == 0 then
      return tokenNames
    end

    return visibleTokenNames
  end

  function ChaosTokenStatsUi.getChaosStatLastFiveForScope(scopeKey)
    assertChaosStatDataSources()

    local scopedHistory = (lastDrawnTokens[scopeKey] or {})
    local result = {}

    local startIndex = math.max(1, #scopedHistory - 4)
    for i = startIndex, #scopedHistory do
      local entry = scopedHistory[i]
      if entry then
        table.insert(result, getReadableTokenName(entry.tokenName or ""))
      end
    end

    return result
  end

  function ChaosTokenStatsUi.getChaosTrackerUiText(id, fallback)
    local value = i18n.getStrById(id)
    if value and value ~= id and value ~= "" then
      return value
    end
    return fallback
  end

  function ChaosTokenStatsUi.createChaosStatGraphColumn(tokenName)
    local uiId = ChaosTokenStatsUi.getChaosStatTokenUiId(tokenName)
    local tokenId = createChaosTokenNameLookupTable()[tokenName]
    local labelElement

    if tokenId then
      labelElement = {
        tag = "Image",
        attributes = {
          id = "chaosStatLabelSymbol_" .. uiId,
          image = "token-" .. tokenId,
          preserveAspect = true,
          preferredWidth = 24,
          preferredHeight = 24
        }
      }
    else
      labelElement = {
        tag = "Text",
        attributes = {
          id = "chaosStatLabel_" .. uiId,
          text = tokenName,
          color = "#DDDDDD",
          alignment = "UpperCenter",
          fontSize = 11,
          preferredHeight = 24
        }
      }
    end

    return {
      tag = "VerticalLayout",
      attributes = {
        id = "chaosStatCol_" .. uiId,
        active = false,
        width = 32,
        preferredHeight = 230,
        spacing = 4
      },
      children = {
        {
          tag = "Text",
          attributes = {
            id = "chaosStatCount_" .. uiId,
            text = "0",
            color = "White",
            alignment = "MiddleCenter",
            fontSize = 13,
            preferredHeight = 20
          }
        },
        {
          tag = "VerticalLayout",
          attributes = {
            preferredHeight = 180,
            color = "#1C1C1C",
            padding = "0 0 0 0"
          },
          children = {
            {
              tag = "Panel",
              attributes = {
                id = "chaosStatSpacer_" .. uiId,
                preferredHeight = 1
              }
            },
            {
              tag = "Panel",
              attributes = {
                id = "chaosStatBar_" .. uiId,
                preferredHeight = 0,
                color = "#6FA8DC"
              }
            }
          }
        },
        {
          tag = "HorizontalLayout",
          attributes = {
            preferredHeight = 24,
            childAlignment = "UpperCenter"
          },
          children = {
            labelElement
          }
        }
      }
    }
  end

