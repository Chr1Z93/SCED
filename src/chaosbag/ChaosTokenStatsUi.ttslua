do
  local ChaosTokenStatsUi         = {}
  local i18nApi                   = require("Global/i18nApi")
  local PlayermatApi              = require("playermat/PlayermatApi")

  local chaosStatSelectedScope    = "Overall"
  local chaosStatTokenFilterMode  = "inBag"
  local chaosStatScopeOptionKeys  = { "Overall" }
  local chaosStatScopeOptionsSig  = ""

  local CHAOS_STAT_FILTER_OPTIONS = {
    { key = "inBag", labelId = "CT_filter_tokens_in_bag" },
    { key = "drawn", labelId = "CT_filter_drawn_tokens" },
    { key = "all",   labelId = "CT_filter_all_tokens" }
  }

  function ChaosTokenStatsUi.getChaosStatScopeOptions()
    local options = {
      {
        key   = "Overall",
        id    = "CT_scope_overall",
        label = i18nApi.getStrById("CT_scope_overall")
      }
    }
    local others = {}
    for key, stats in pairs(tokenDrawingStats) do
      if key ~= "Overall" then
        local hasData = false
        for _, count in pairs(stats or {}) do
          if (count or 0) > 0 then
            hasData = true
            break
          end
        end
        if hasData then
          table.insert(others, { key = key, label = getDisplayName(key) })
        end
      end
    end

    table.sort(others, function(a, b)
      return string.lower(a.label) < string.lower(b.label)
    end)

    for _, option in ipairs(others) do
      table.insert(options, option)
    end

    return options
  end

  function ChaosTokenStatsUi.updateChaosStatScopeDropdown(scopeOptions)
    local labels = {}
    chaosStatScopeOptionKeys = {}

    for i, option in ipairs(scopeOptions) do
      labels[i] = option.label
      chaosStatScopeOptionKeys[i] = option.key
    end

    local signature = table.concat(chaosStatScopeOptionKeys, "|") .. "::" .. table.concat(labels, "|")

    if chaosStatScopeOptionsSig ~= signature then
      local globalXml = Global.UI.getXmlTable() or {}
      local dropdown  = getXmlTableElementById(globalXml, "chaosStatScopeDropdown")
      if dropdown then
        dropdown.children = {}
        for i, label in ipairs(labels) do
          local option = scopeOptions[i]
          table.insert(dropdown.children, {
            tag        = "Option",
            value      = label,
            attributes = { id = option.id }
          })
        end
        updateGlobalXml(globalXml)
      end
      chaosStatScopeOptionsSig = signature
    end

    local selectedIndex = 0
    for i, key in ipairs(chaosStatScopeOptionKeys) do
      if key == chaosStatSelectedScope then
        selectedIndex = i - 1
        break
      end
    end
    UI.setAttribute("chaosStatScopeDropdown", "value", selectedIndex)
  end

  function ChaosTokenStatsUi.setChaosStatScopeFromClick(player, clickType)
    if clickType ~= "-3" then
      chaosStatSelectedScope = "Overall"
    else
      chaosStatSelectedScope = PlayermatApi.getMatColor(player.color) or "Overall"
    end
  end

  function ChaosTokenStatsUi.onChaosStatScopeDropdownChanged(_, selectedIndex)
    local numericIndex = tonumber(selectedIndex)
    if numericIndex == nil then return end

    local index    = numericIndex + 1
    local scopeKey = chaosStatScopeOptionKeys[index]
    if scopeKey == nil then return end

    chaosStatSelectedScope = scopeKey
    ChaosTokenStatsUi.renderChaosStatTrackerUi()
  end

  function ChaosTokenStatsUi.onChaosStatTokenFilterDropdownChanged(_, selectedIndex)
    local numericIndex = tonumber(selectedIndex)
    if numericIndex == nil then return end

    local index          = numericIndex + 1
    local selectedOption = CHAOS_STAT_FILTER_OPTIONS[index]
    if not selectedOption then return end

    chaosStatTokenFilterMode = selectedOption.key
    ChaosTokenStatsUi.renderChaosStatTrackerUi()
  end

  function ChaosTokenStatsUi.getChaosStatTokenUiId(tokenName)
    return tokenName:gsub("%+", "plus_"):gsub("%-", "minus_"):gsub("[^%w]", "_")
  end

  function ChaosTokenStatsUi.getChaosStatTokenOrder()
    local tokenNames = {}
    for _, tokenData in pairs(ID_URL_MAP) do
      table.insert(tokenNames, tokenData.name)
    end
    table.insert(tokenNames, getReadableTokenName(""))

    return tokenNames
  end

  function ChaosTokenStatsUi.getChaosStatVisibleTokenOrder(scopeStats)
    local tokenNames = ChaosTokenStatsUi.getChaosStatTokenOrder()
    if chaosStatTokenFilterMode == "all" then
      return tokenNames
    end

    local visibleTokenNames = {}
    if chaosStatTokenFilterMode == "inBag" then
      local inBag = {}
      for _, token in ipairs(findChaosBag().getObjects()) do
        inBag[token.name] = true
      end

      for _, tokenName in ipairs(tokenNames) do
        if inBag[tokenName] then
          table.insert(visibleTokenNames, tokenName)
        end
      end
    elseif chaosStatTokenFilterMode == "drawn" then
      for _, tokenName in ipairs(tokenNames) do
        if scopeStats[tokenName] and scopeStats[tokenName] > 0 then
          table.insert(visibleTokenNames, tokenName)
        end
      end
    end

    if #visibleTokenNames == 0 then
      return tokenNames
    end

    return visibleTokenNames
  end

  function ChaosTokenStatsUi.getChaosStatLastFiveForScope(scopeKey)
    local scopedHistory = (lastDrawnTokens[scopeKey] or {})
    local result        = {}
    local startIndex    = math.max(1, #scopedHistory - 4)
    for i = startIndex, #scopedHistory do
      local entry = scopedHistory[i]
      if entry then
        table.insert(result, getReadableTokenName(entry.tokenName or ""))
      end
    end

    return result
  end

