do
  local WebRequestLib = {}

  -- Helper function to format URI if it's a table (e.g., {"api", "data"} -> "api/data")
  ---@param uri table|string The URL for the request.
  local function formatUri(uri)
    if type(uri) == "table" then
      local lastIdx  = #uri
      local lastItem = uri[lastIdx]

      -- Check if the last item starts with "?"
      if string.sub(lastItem, 1, 1) == "?" then
        -- Remove the last item temporarily, join the rest, then append it back without a slash
        table.remove(uri, lastIdx)
        return table.concat(uri, "/") .. lastItem
      else
        return table.concat(uri, "/")
      end
    end

    return uri
  end

  -- Shared callback handler to process network errors, HTTP status codes, and success states
  ---@param onSuccess fun(content: string) Called when the request is successful.
  ---@param onError fun(errorMessage: string, responseCode: number|nil) Called when an error occurs.
  local function handleResponse(requestInstance, onSuccess, onError)
    if requestInstance.is_error then
      -- Network level error
      local errorMessage = requestInstance.error or "Unknown network error"
      if onError then
        onError(errorMessage)
      end
    elseif requestInstance.response_code and requestInstance.response_code >= 400 then
      -- 4xx or 5xx status codes
      if onError then
        onError(requestInstance.text, requestInstance.response_code)
      end
    else
      -- Successful request (2xx or 3xx status codes)
      if onSuccess then
        onSuccess(requestInstance.text)
      end
    end
  end

  -- This function encapsulates the GET request logic.
  ---@param uri table|string The URL for the request.
  ---@param onSuccess fun(content: string) Called when the request is successful.
  ---@param onError fun(errorMessage: string, responseCode: number|nil) Called when an error occurs.
  function WebRequestLib.get(uri, onSuccess, onError)
    WebRequest.get(formatUri(uri), function(requestInstance)
      handleResponse(requestInstance, onSuccess, onError)
    end)
  end

  -- This function encapsulates the POST request logic.
  ---@param uri table|string The URL for the request.
  ---@param form table|string The form data to post (Table keys and values must be strings if using a table).
  ---@param onSuccess fun(content: string) Called when the request is successful.
  ---@param onError fun(errorMessage: string, responseCode: number|nil) Called when an error occurs.
  function WebRequestLib.post(uri, form, onSuccess, onError)
    WebRequest.post(formatUri(uri), form, function(requestInstance)
      handleResponse(requestInstance, onSuccess, onError)
    end)
  end

  -- Custom WebRequest to send JSON data.
  ---@param uri table|string The URL for the request.
  ---@param data table The JSON data to post.
  ---@param onSuccess fun(content: string) Called when the request is successful.
  ---@param onError fun(errorMessage: string, responseCode: number|nil) Called when an error occurs.
  function WebRequestLib.postJson(uri, data, onSuccess, onError)
    local headers = {
      ["Content-Type"] = "application/json",
      ["Accept"] = "application/json"
    }

    WebRequest.custom(
      formatUri(uri),
      "POST",
      true,
      data,
      headers,
      function(requestInstance)
        handleResponse(requestInstance, onSuccess, onError)
      end
    )
  end

  return WebRequestLib
end
