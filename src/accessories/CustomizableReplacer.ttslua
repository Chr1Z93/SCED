--Finds the correct front card url based on the search code it receives.
function getFrontURL(cardMetadataID, searchCode)
  local cardImageUrls = CARD_IMAGE_URLS[cardMetadataID]
  if not cardImageUrls or not cardImageUrls[searchCode] then return end
  return cardImageUrls[searchCode]
end

function onLoad()
  self.createButton({
    click_function = "onClick_Process",
    function_owner = self,
    label          = "Update card",
    tooltip        = "Replace the Level 0 card with the appropriate upgraded card",
    position       = { x = 0, y = 0.12, z = -0.8 },
    font_size      = 200,
    width          = 1200,
    height         = 300,
    scale          = { 0.5, 1, 0.5 }
  })
  printToAll("Customizable cards will be automatically replaced with specific images when possible.")
  printToAll("This is automatically triggered by collision with the playermat or changes to the respective upgradesheet.")
  printToAll("Note that only the taboo version of Empirical Hypothesis, Runic Axe and Power Word is supported.")
end

--Special handling for Summoned Servitor's slot-drop option.
function summonedServitorSlotHandling(servitorUpgradeCard, currentSearchCode)
  local scriptData = JSON.decode(servitorUpgradeCard.script_state or "") or {}
  local selections = scriptData.selections or {}
  local chosenSlot = selections[6] and selections[6].text or ""

  if chosenSlot == "0" then
    -- Arcane selected, so use the card image with Ally removed.
    currentSearchCode = currentSearchCode .. "noally"
  elseif chosenSlot == "1" then
    -- Ally selected, so use the card image with Arcane removed.
    currentSearchCode = currentSearchCode .. "noarcane"
  end
  return currentSearchCode
end

--Function to execute the change to the card's face
function cardFaceChanger(newFrontUrl, baseCard)
  local baseCardData = baseCard.getData()
  local deckId, customDeckData = next(baseCardData.CustomDeck)

  --If the card's face url already matches the target, don't make the swap, and don't destory and recreate the card.
  if customDeckData.FaceURL == newFrontUrl then return end

  customDeckData.NumWidth  = 1
  customDeckData.NumHeight = 1
  customDeckData.FaceURL   = newFrontUrl

  -- add the custom deck data to the card data
  baseCardData.CustomDeck  = { [deckId] = customDeckData }

  -- destroy the original and respawn it
  baseCard.destruct()
  spawnObjectData({ data = baseCardData })
end

--Function runs when both base player card and its upgrade sheet are found.
--Reads the active customizations, finds the correct new card face, and applies it to the card.
function updateCardImage(upgradeInfo)
  local basePlayerCard         = upgradeInfo.card
  local basePlayerCardMetadata = upgradeInfo.metadata
  local upgradeSheet           = upgradeInfo.upgradeSheet

  if not basePlayerCardMetadata or not upgradeSheet or not basePlayerCardMetadata.customizations then
    log("updateCardImage missing required data")
    return
  end

  local searchCode = ""
  --Build searchCode by iterating through the upgrades and checking which are active.
  for i = 1, #basePlayerCardMetadata.customizations do
    if upgradeSheet.call("isUpgradeActive", i) then
      --Special handling for Grizzled, Raven Quill, FiLP, and Living Ink because their upgrade sheets
      --have a table entry for trait/skill which pushes the searchCode matching off by one line.
      if basePlayerCardMetadata.id == "09101" or basePlayerCardMetadata.id == "09042" or
          basePlayerCardMetadata.id == "09060" or basePlayerCardMetadata.id == "09079" then
        searchCode = searchCode .. string.char(string.byte("a") + i - 2)
      else
        searchCode = searchCode .. string.char(string.byte("a") + i - 1)
      end
    end
  end

  -- Special handling for Summoned Servitor with the Dominance upgrade.
  if basePlayerCardMetadata.id == "09080" and string.find(searchCode, "f", 1, true) then
    searchCode = summonedServitorSlotHandling(upgradeSheet, searchCode)
  end

  --Change the front URL if searchCode got populated with anything.
  if searchCode ~= "" then
    local newFrontURL = getFrontURL(basePlayerCardMetadata.id, searchCode)
    if newFrontURL then
      cardFaceChanger(newFrontURL, basePlayerCard)
    end
  end
end

function onClick_Process()
  local foundSheets = false
  --loop through the cards on the card searcher object,
  --first finding an upgrade sheet, then looking for the the corresponding base card.
  for _, card in ipairs(SearchLib.onObject(self, "isCard")) do
    local UpgradeSheetMetadata = JSON.decode(card.getGMNotes()) or {}
    if UpgradeSheetMetadata.type == "UpgradeSheet" then
      foundSheets = true

      --Found an upgrade sheet, now find its base card.
      for _, baseCard in ipairs(SearchLib.onObject(self, "isCard")) do
        local baseCardMetadata = JSON.decode(baseCard.getGMNotes()) or {}

        --Special handling for Emp. Hypo because there's a taboo of the base card but not the upgrade sheet.
        if baseCardMetadata.id == "09041-t" then
          baseCardMetadata.id = "09041"
        end

        --If the metadata for the base card and upgrade card match, proceed with the card image swap
        if UpgradeSheetMetadata.id == (baseCardMetadata.id .. "-c") then
          updateCardImage({ card = baseCard, metadata = baseCardMetadata, upgradeSheet = card })
        end
      end
    end
  end

  if not foundSheets then
    printToAll("No upgrade sheets found on object.", "Yellow")
  end
end
