-- Settings

local DEFAULT_DECK_MODE          = "m30"
local DEFAULT_INVESTIGATOR_CLASS = "Neutral"
local SNAP_HEIGHT                = 0.12
local BOARD_CAPTURE_MARGIN_X     = 0.60
local BOARD_CAPTURE_MARGIN_Z     = 0.60

-- XP counter
local XP_REFRESH_DELAY           = 0.35
local XP_BUTTON_INDEX            = 1

-- Deck export
local EXPORT_BUTTON_INDEX        = 2
local EXPORT_STACK_OFFSET_X      = -0.3
local EXPORT_STACK_HEIGHT        = 0.85
local EXPORT_CARD_DELAY_FRAMES   = 2

-- Object detection uses actual snap-slot positions rather than one large
-- rectangular board area. This keeps the exported stack outside XP counting.
local MAIN_SLOT_CAPTURE_X        = 0.105
local MAIN_SLOT_CAPTURE_Z        = 0.155
local AUX_SLOT_CAPTURE_X         = 0.115
local AUX_SLOT_CAPTURE_Z         = 0.180

local BOARD_LAYOUTS              = {
  m30 = {
    boardObjectScale  = 9.52,
    coordinateScaleX  = 1.000,
    coordinateScaleZ  = 1.000,
    coordinateOffsetX = -0.263,
    coordinateOffsetZ = 0.195,
    buttonScale       = 0.200,
    buttonPositions   = {
      deckSize = { 0.00, 0.18, -1.073 },
      xp       = { -1.17, 0.18, -1.073 },
      export   = { 1.14, 0.18, -1.073 }
    },
    topSlotZ          = -0.966,
    topSlots          = {
      { x = 1.327, rotationY = 90 },
      { x = 0.927, rotationY = 90 },
      { x = 0.642, rotationY = 0 }
    },
    sideSlotZ         = -0.939,
    sideSlotXs        = { 0.388, 0.137, -0.114, -0.366, -0.617, -0.870 },
    cardGridColumnXs  = { 1.398, 1.145, 0.893, 0.640, 0.388, 0.137, -0.114, -0.366, -0.617, -0.870 },
    cardGridRowZs     = { -0.477, -0.131, 0.215, 0.562 }
  },
  m50 = {
    boardObjectScale  = 12.94,
    coordinateScaleX  = 0.755,
    coordinateScaleZ  = 0.755,
    coordinateOffsetX = -0.190,
    coordinateOffsetZ = 0.200,

    buttonScale       = 0.151,
    buttonPositions   = {
      deckSize = { 0, 0.18, -1.055 },
      xp       = { -0.845, 0.18, -1.055 },
      export   = { 0.815, 0.18, -1.055 }
    },
    topSlotZ          = -1.357,
    topSlots          = {
      { x = 1.286, rotationY = 90 },
      { x = 0.895, rotationY = 90 },
      { x = 0.618, rotationY = 0 }
    },
    sideSlotZ         = -1.330,
    sideSlotXs        = { 0.371, 0.126, -0.120, -0.365, -0.611, -0.856 },
    cardGridColumnXs  = { 1.353, 1.107, 0.862, 0.617, 0.371, 0.126, -0.120, -0.365, -0.611, -0.856 },
    cardGridRowZs     = { -0.879, -0.539, -0.204, 0.133, 0.470, 0.806 }
  }
}

local PROTECTED_OBJECT_TYPES     = {
  Card         = true,
  Deck         = true,
  Tile         = true,
  Custom_Tile  = true,
  Custom_Token = true,
  Figurine     = true,
  Bag          = true
}

local currentDeckMode            = DEFAULT_DECK_MODE
local currentInvestigatorClass   = DEFAULT_INVESTIGATOR_CLASS
local collisionEnabled           = false
local currentExperience          = 0
local xpRefreshScheduled         = false
local exportInProgress           = false

-- Loading and saving

function onLoad(savedData)
  collisionEnabled = false

  if savedData and savedData ~= "" then
    local savedState         = JSON.decode(savedData)
    currentDeckMode          = savedState.deckMode or DEFAULT_DECK_MODE
    currentInvestigatorClass = savedState.investigatorClass or DEFAULT_INVESTIGATOR_CLASS
  end

  createDashboardButtons()
  applySnapPoints(self)
  Wait.frames(function() applyBoardScale(self) end, 2)
  Wait.time(function()
    collisionEnabled = true
    refreshExperience()
  end, 0.5)
end

function saveBoardState()
  self.script_state = JSON.encode({ deckMode = currentDeckMode, investigatorClass = currentInvestigatorClass })
end

-- Deck size button

function createDashboardButtons()
  self.clearButtons()

  local activeLayout = getActiveLayout()
  local buttonPositions = activeLayout.buttonPositions
  local buttonScale = activeLayout.buttonScale

  -- Button index 0: deck size
  self.createButton({
    click_function = "switchDeckSize",
    function_owner = self,
    position       = buttonPositions.deckSize,
    rotation       = { 0, 0, 0 },
    scale          = { buttonScale, 1, buttonScale },
    width          = 350,
    height         = 250,
    font_size      = 200,
    label          = getDeckSizeLabel(),
    tooltip        = "Switch between 30-card and 50-card dashboard",
    color          = { 0.15, 0.12, 0.08, 0.55 },
    font_color     = { 1, 0.92, 0.75, 1 }
  })

  -- Button index 1: XP counter / manual refresh
  self.createButton({
    click_function = "refreshExperience",
    function_owner = self,
    position       = buttonPositions.xp,
    rotation       = { 0, 0, 0 },
    scale          = { buttonScale, 1, buttonScale },
    width          = 650,
    height         = 250,
    font_size      = 150,
    label          = getExperienceLabel(),
    tooltip        =
    "Total XP on this side-deck board. Myriad and Exceptional cannot be calculated automatically; please adjust the total manually",
    color          = { 0.15, 0.12, 0.08, 0.55 },
    font_color     = { 1, 0.92, 0.75, 1 }
  })

  -- Button index 2: export the main card grid as one stack
  self.createButton({
    click_function = "exportDeck",
    function_owner = self,
    position       = buttonPositions.export,
    rotation       = { 0, 0, 0 },
    scale          = { buttonScale, 1, buttonScale },
    width          = 850,
    height         = 250,
    font_size      = 115,
    label          = "EXPORT",
    tooltip        =
    "Copy all cards in the main deck area into one deck right beside the dashboard. Top permanent slots are excluded.",
    color          = { 0.15, 0.12, 0.08, 0.55 },
    font_color     = { 1, 0.92, 0.75, 1 }
  })
end

function getDeckSizeLabel()
  return currentDeckMode == "m30" and "30" or "50"
end

function switchDeckSize()
  currentDeckMode = currentDeckMode == "m30" and "m50" or "m30"
  saveBoardState()
  self.editButton({ index = 0, label = getDeckSizeLabel() })
  reloadBoardTexture()
end

-- Investigator detection

function onCollisionEnter(collisionInfo)
  if not collisionEnabled then return end

  local collidedObject = collisionInfo.collision_object
  if not collidedObject then return end

  if collidedObject.type == "Card" or collidedObject.type == "Deck" then
    scheduleExperienceRefresh()
  end

  -- Investigator detection only applies to individual cards.
  if collidedObject.type ~= "Card" then return end

  local cardLocalPosition = self.positionToLocal(collidedObject.getPosition())
  if not isInsideInvestigatorSlot(cardLocalPosition) then return end

  local decodedSuccessfully, cardMetadata = pcall(JSON.decode, collidedObject.getGMNotes())
  if not decodedSuccessfully or not cardMetadata then return end
  if cardMetadata.type ~= "Investigator" then return end
  if not BOARD_TEXTURES[cardMetadata.class] then return end
  if cardMetadata.class == currentInvestigatorClass then return end

  collisionEnabled = false
  currentInvestigatorClass = cardMetadata.class
  saveBoardState()
  reloadBoardTexture()
end

function onCollisionExit(collisionInfo)
  if not collisionEnabled then return end

  local collidedObject = collisionInfo.collision_object
  if not collidedObject then return end

  if collidedObject.type == "Card" or collidedObject.type == "Deck" then
    scheduleExperienceRefresh()
  end
end

function isInsideInvestigatorSlot(cardLocalPosition)
  local activeLayout = getActiveLayout()
  local investigatorSlot = activeLayout.topSlots[1]
  local slotX, slotZ = convertLayoutPoint(activeLayout, investigatorSlot.x, activeLayout.topSlotZ)

  return math.abs(cardLocalPosition.x - slotX) <= 0.55
      and math.abs(cardLocalPosition.z - slotZ) <= 0.35
end

-- Experience counter

function getExperienceLabel()
  return "XP: " .. tostring(currentExperience)
end

function scheduleExperienceRefresh()
  if xpRefreshScheduled then return end
  xpRefreshScheduled = true

  Wait.time(function()
    xpRefreshScheduled = false
    refreshExperience()
  end, XP_REFRESH_DELAY)
end

function refreshExperience()
  currentExperience = calculateExperienceOnBoard()

  local buttons = self.getButtons()
  if buttons and buttons[XP_BUTTON_INDEX + 1] then
    self.editButton({
      index = XP_BUTTON_INDEX,
      label = getExperienceLabel()
    })
  end

  return currentExperience
end

function calculateExperienceOnBoard()
  local totalExperience = 0

  for _, worldObject in ipairs(collectExperienceObjects()) do
    if worldObject.type == "Card" then
      totalExperience = totalExperience + getCardExperience(worldObject.getGMNotes())
    elseif worldObject.type == "Deck" then
      for _, containedCard in ipairs(worldObject.getObjects()) do
        totalExperience = totalExperience + getCardExperience(containedCard.gm_notes)
      end
    end
  end

  return totalExperience
end

function collectExperienceObjects()
  local collectedObjects = {}
  local boardGuid = self.getGUID()

  for _, worldObject in ipairs(getAllObjects()) do
    if worldObject.getGUID() ~= boardGuid
        and (worldObject.type == "Card"
          or worldObject.type == "Deck") then
      local localPosition = self.positionToLocal(worldObject.getPosition())

      -- XP includes cards in the main grid, top slots and side slots,
      -- but excludes nearby objects such as the exported deck.
      if isPositionInsideAnyBoardSlot(localPosition) then
        table.insert(collectedObjects, worldObject)
      end
    end
  end

  return collectedObjects
end

function getCardExperience(gmNotes)
  local metadata = decodeCardMetadata(gmNotes)
  if not metadata then return 0 end

  local cardLevel = tonumber(metadata.level)
  if not cardLevel or cardLevel < 0 then return 0 end

  return cardLevel
end

function decodeCardMetadata(gmNotes)
  if not gmNotes or gmNotes == "" then return nil end

  local decodedSuccessfully, metadata = pcall(JSON.decode, gmNotes)

  if not decodedSuccessfully or type(metadata) ~= "table" then
    return nil
  end

  return metadata
end

function isPositionInsideAnyBoardSlot(localPosition)
  local activeLayout = getActiveLayout()

  -- Main deck grid.
  for _, sourceZ in ipairs(activeLayout.cardGridRowZs) do
    for _, sourceX in ipairs(activeLayout.cardGridColumnXs) do
      local slotX, slotZ =
          convertLayoutPoint(activeLayout, sourceX, sourceZ)

      if isPositionNearSlot(
            localPosition,
            slotX,
            slotZ,
            MAIN_SLOT_CAPTURE_X,
            MAIN_SLOT_CAPTURE_Z
          ) then
        return true
      end
    end
  end

  -- Investigator/signature/permanent slots.
  for _, topSlot in ipairs(activeLayout.topSlots) do
    local slotX, slotZ =
        convertLayoutPoint(
          activeLayout,
          topSlot.x,
          activeLayout.topSlotZ
        )

    local toleranceX = AUX_SLOT_CAPTURE_X
    local toleranceZ = AUX_SLOT_CAPTURE_Z

    -- Rotated cards have their long and short sides exchanged.
    if topSlot.rotationY == 90
        or topSlot.rotationY == 270 then
      toleranceX = AUX_SLOT_CAPTURE_Z
      toleranceZ = AUX_SLOT_CAPTURE_X
    end

    if isPositionNearSlot(
          localPosition,
          slotX,
          slotZ,
          toleranceX,
          toleranceZ
        ) then
      return true
    end
  end

  -- Side permanent slots.
  for _, sourceX in ipairs(activeLayout.sideSlotXs) do
    local slotX, slotZ =
        convertLayoutPoint(
          activeLayout,
          sourceX,
          activeLayout.sideSlotZ
        )

    if isPositionNearSlot(
          localPosition,
          slotX,
          slotZ,
          AUX_SLOT_CAPTURE_X,
          AUX_SLOT_CAPTURE_Z
        ) then
      return true
    end
  end

  return false
end

function isPositionNearSlot(
    localPosition,
    slotX,
    slotZ,
    toleranceX,
    toleranceZ
)
  return math.abs(localPosition.x - slotX) <= toleranceX
      and math.abs(localPosition.z - slotZ) <= toleranceZ
end

-- Deck export

function exportDeck(_, playerColor, altClick)
  if exportInProgress then
    if playerColor then
      printToColor("Deck export is already in progress.", playerColor, { 1, 0.75, 0.25 })
    end
    return
  end

  local sourceObjects = collectMainGridObjects()
  if #sourceObjects == 0 then
    if playerColor then
      printToColor("No cards found in the main deck grid.", playerColor, { 1, 0.75, 0.25 })
    else
      print("No cards found in the main deck grid.")
    end
    return
  end

  exportInProgress = true
  collisionEnabled = false

  local stackPosition = getExportStackWorldPosition()
  local stackRotation = self.getRotation()

  -- Exported cards are placed face down.
  stackRotation.x = 0
  stackRotation.z = 180

  local createdObjects = {}

  for index, sourceObject in ipairs(sourceObjects) do
    Wait.frames(function()
      if sourceObject then
        local clone = sourceObject.clone({
          position = {
            stackPosition.x,
            stackPosition.y + (index - 1) * 0.12,
            stackPosition.z
          },
          rotation = stackRotation,
          smooth   = false
        })

        if clone then
          clone.setLock(false)
          clone.resting = false
          table.insert(createdObjects, clone)
        end
      end
    end, (index - 1) * EXPORT_CARD_DELAY_FRAMES)
  end

  Wait.frames(function()
    exportInProgress = false
    collisionEnabled = true
    scheduleExperienceRefresh()

    if playerColor then
      printToColor(
        "Copied " .. tostring(#sourceObjects) .. " card object(s) into one exported stack.",
        playerColor,
        { 0.65, 1, 0.65 }
      )
    end
  end, #sourceObjects * EXPORT_CARD_DELAY_FRAMES + 30)
end

function collectMainGridObjects()
  local collectedObjects = {}
  local boardGuid = self.getGUID()

  for _, worldObject in ipairs(getAllObjects()) do
    if worldObject.getGUID() ~= boardGuid
        and (worldObject.type == "Card"
          or worldObject.type == "Deck")
        and not worldObject.getLock() then
      local localPosition =
          self.positionToLocal(worldObject.getPosition())

      -- Export only cards actually occupying main-grid snap slots.
      -- Top and side permanent slots are intentionally excluded.
      if isPositionInsideMainGridSlot(localPosition) then
        table.insert(collectedObjects, {
          object = worldObject,
          x = localPosition.x,
          z = localPosition.z
        })
      end
    end
  end

  -- Predictable order: top-to-bottom, then left-to-right.
  table.sort(collectedObjects, function(a, b)
    if math.abs(a.z - b.z) > 0.03 then
      return a.z < b.z
    end

    return a.x > b.x
  end)

  local result = {}

  for _, item in ipairs(collectedObjects) do
    table.insert(result, item.object)
  end

  return result
end

function isPositionInsideMainGridSlot(localPosition)
  local activeLayout = getActiveLayout()

  for _, sourceZ in ipairs(activeLayout.cardGridRowZs) do
    for _, sourceX in ipairs(activeLayout.cardGridColumnXs) do
      local slotX, slotZ = convertLayoutPoint(activeLayout, sourceX, sourceZ)

      if isPositionNearSlot(
            localPosition,
            slotX,
            slotZ,
            MAIN_SLOT_CAPTURE_X,
            MAIN_SLOT_CAPTURE_Z
          ) then
        return true
      end
    end
  end

  return false
end

function calculateMainGridBounds()
  local activeLayout = getActiveLayout()
  local minimumX, maximumX = math.huge, -math.huge
  local minimumZ, maximumZ = math.huge, -math.huge

  local convertedColumns = {}
  local convertedRows = {}

  for _, sourceX in ipairs(activeLayout.cardGridColumnXs) do
    local localX = convertLayoutPoint(activeLayout, sourceX, 0)
    table.insert(convertedColumns, localX)
    minimumX = math.min(minimumX, localX)
    maximumX = math.max(maximumX, localX)
  end

  for _, sourceZ in ipairs(activeLayout.cardGridRowZs) do
    local _, localZ = convertLayoutPoint(activeLayout, 0, sourceZ)
    table.insert(convertedRows, localZ)
    minimumZ = math.min(minimumZ, localZ)
    maximumZ = math.max(maximumZ, localZ)
  end

  local columnTolerance = calculateHalfSpacing(convertedColumns, 0.13)
  local rowTolerance = calculateHalfSpacing(convertedRows, 0.18)

  return {
    minX = minimumX - columnTolerance,
    maxX = maximumX + columnTolerance,
    minZ = minimumZ - rowTolerance,
    maxZ = maximumZ + rowTolerance
  }
end

function calculateHalfSpacing(values, fallback)
  if #values < 2 then return fallback end

  table.sort(values)
  local minimumSpacing = math.huge

  for index = 2, #values do
    minimumSpacing = math.min(minimumSpacing, values[index] - values[index - 1])
  end

  if minimumSpacing == math.huge or minimumSpacing <= 0 then
    return fallback
  end

  return minimumSpacing * 0.48
end

function getExportStackWorldPosition()
  local mainGridBounds = calculateMainGridBounds()
  local localTarget = {
    x = mainGridBounds.minX + EXPORT_STACK_OFFSET_X,
    y = EXPORT_STACK_HEIGHT,
    z = (mainGridBounds.minZ + mainGridBounds.maxZ) / 2
  }

  return self.positionToWorld(localTarget)
end

-- Board texture and scale

function reloadBoardTexture()
  local targetTexture = BOARD_TEXTURES[currentInvestigatorClass][currentDeckMode]
  local customObjectConfig = self.getCustomObject()

  if customObjectConfig.image == targetTexture then
    applyBoardScale(self)
    applySnapPoints(self)
    createDashboardButtons()
    refreshExperience()
    collisionEnabled = true
    scheduleExperienceRefresh()
    return
  end

  collisionEnabled = false

  local capturedObjects = captureObjectsOnBoard()
  customObjectConfig.image = targetTexture
  self.setCustomObject(customObjectConfig)

  local reloadedBoard = self.reload()

  Wait.condition(
    function()
      Wait.frames(function()
        applyBoardScale(reloadedBoard)
        applySnapPoints(reloadedBoard)
        restoreCapturedObjects(capturedObjects)
        collisionEnabled = true
        scheduleExperienceRefresh()
      end, 2)
    end,
    function()
      return not reloadedBoard.loading_custom
    end
  )
end

function applyBoardScale(boardObject)
  local boardScale = getActiveLayout().boardObjectScale
  local currentScaleY = boardObject.getScale().y
  boardObject.setScale({ boardScale, currentScaleY, boardScale })
end

-- Object protection

function captureObjectsOnBoard()
  local capturedObjects = {}
  local boardSnapBounds = calculateSnapBounds()
  local boardGuid = self.getGUID()

  for _, worldObject in ipairs(getAllObjects()) do
    local shouldCapture = worldObject.getGUID() ~= boardGuid
        and PROTECTED_OBJECT_TYPES[worldObject.type]
        and not worldObject.getLock()

    if shouldCapture then
      local localPosition = self.positionToLocal(worldObject.getPosition())
      local insideCaptureArea =
          localPosition.x >= boardSnapBounds.minX - BOARD_CAPTURE_MARGIN_X
          and localPosition.x <= boardSnapBounds.maxX + BOARD_CAPTURE_MARGIN_X
          and localPosition.z >= boardSnapBounds.minZ - BOARD_CAPTURE_MARGIN_Z
          and localPosition.z <= boardSnapBounds.maxZ + BOARD_CAPTURE_MARGIN_Z

      if insideCaptureArea then
        table.insert(capturedObjects, {
          object   = worldObject,
          position = worldObject.getPosition(),
          rotation = worldObject.getRotation()
        })
        worldObject.resting = true
      end
    end
  end

  return capturedObjects
end

function restoreCapturedObjects(capturedObjects)
  for _, capturedObject in ipairs(capturedObjects) do
    if capturedObject.object then
      capturedObject.object.setPosition(capturedObject.position)
      capturedObject.object.setRotation(capturedObject.rotation)
      capturedObject.object.resting = true
    end
  end
end

-- Snap points

function convertLayoutPoint(activeLayout, sourceX, sourceZ)
  local localX = sourceX * activeLayout.coordinateScaleX + activeLayout.coordinateOffsetX
  local localZ = sourceZ * activeLayout.coordinateScaleZ + activeLayout.coordinateOffsetZ
  return localX, localZ
end

function buildSnapPoints()
  local activeLayout = getActiveLayout()
  local snapPoints = {}

  local function addSnapPoint(sourceX, sourceZ, rotationY)
    local localX, localZ = convertLayoutPoint(activeLayout, sourceX, sourceZ)
    table.insert(snapPoints, {
      position      = { localX, SNAP_HEIGHT, localZ },
      rotation      = { 0, rotationY, 0 },
      rotation_snap = false
    })
  end

  for _, topSlot in ipairs(activeLayout.topSlots) do
    addSnapPoint(topSlot.x, activeLayout.topSlotZ, topSlot.rotationY)
  end

  for _, sideSlotX in ipairs(activeLayout.sideSlotXs) do
    addSnapPoint(sideSlotX, activeLayout.sideSlotZ, 0)
  end

  for _, rowZ in ipairs(activeLayout.cardGridRowZs) do
    for _, columnX in ipairs(activeLayout.cardGridColumnXs) do
      addSnapPoint(columnX, rowZ, 0)
    end
  end

  return snapPoints
end

function applySnapPoints(boardObject)
  boardObject.setSnapPoints(buildSnapPoints())
end

function calculateSnapBounds()
  local minimumX, maximumX = math.huge, -math.huge
  local minimumZ, maximumZ = math.huge, -math.huge

  for _, snapPoint in ipairs(buildSnapPoints()) do
    local position = snapPoint.position
    minimumX = math.min(minimumX, position[1])
    maximumX = math.max(maximumX, position[1])
    minimumZ = math.min(minimumZ, position[3])
    maximumZ = math.max(maximumZ, position[3])
  end

  return {
    minX = minimumX,
    maxX = maximumX,
    minZ = minimumZ,
    maxZ = maximumZ
  }
end

function getActiveLayout()
  return BOARD_LAYOUTS[currentDeckMode]
end
