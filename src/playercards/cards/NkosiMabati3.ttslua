require("playercards/CardsWithHelper")
local ChaosBagApi  = require("chaosbag/ChaosBagApi")

-- intentionally global
hasXML             = false
isHelperEnabled    = false

local namesToIds   = {}

-- XML background color for each token
local TOKEN_COLOR  = {
  ["Skull"]       = "#4A0400E6",
  ["Cultist"]     = "#173B0BE6",
  ["Tablet"]      = "#1D2238E6",
  ["Elder Thing"] = "#4D2331E6",
  ["Auto-fail"]   = "#9B0004E6",
  ["Bless"]       = "#9D702CE6",
  ["Curse"]       = "#633A84E6",
  ["Frost"]       = "#4A487BE6",
  ["Blood"]       = "#C32127E6",
  [""]            = "#77674DE6"
}
local VALID_TOKENS = {
  ["Tablet"]      = true,
  ["Elder Thing"] = true,
  ["Cultist"]     = true
}

function updateSave()
  self.script_state = JSON.encode({ isHelperEnabled = isHelperEnabled, sigil = sigil })
end

function onLoad(savedData)
  if savedData and savedData ~= "" then
    local loadedData = JSON.decode(savedData)
    isHelperEnabled  = loadedData.isHelperEnabled
    sigil            = loadedData.sigil
  end
  namesToIds = Global.call("createChaosTokenNameLookupTable")

  createXml()

  if isHelperEnabled then
    updateDisplay()
  end
end

function initialize()
  updateXml()
end

function shutOff()
  updateXml()
end

function createXml()
  self.UI.setXmlTable({
    {
      tag = "Defaults",
      children = {
        {
          tag = "Button",
          attributes = {
            font     = "font_teutonic-arkham",
            scale    = "0.1 0.1 1",
            rotation = "0 0 180",
          }
        }
      }
    },
    {
      tag = "Button",
      attributes = {
        height        = 450,
        width         = 1400,
        position      = "0 -55 -40",
        padding       = "50 50 50 50",
        fontSize      = 300,
        iconWidth     = 400,
        iconAlignment = "Right",
        onClick       = "resolveSigil",
        id            = "Card_NkosiMabati_resolve_text",
        text          = "Resolve"
      }
    },
    {
      tag = "Button",
      attributes = {
        height   = 200,
        width    = 500,
        position = "65 125 -40",
        padding  = "30 30 30 30",
        fontSize = 110,
        onClick  = "chooseSigil",
        id       = "Card_NkosiMabati_reset_text",
        text     = "Reset Sigil"
      }
    },
    {
      tag = "Button",
      attributes = {
        height   = 450,
        width    = 1400,
        position = "0 -55 -40",
        padding  = "50 50 50 50",
        fontSize = 300,
        onClick  = "chooseSigil",
        color    = "#77674DE6",
        id       = "Card_NkosiMabati_choose_text",
        text     = "Choose Sigil"
      }
    }
  })
end

function updateXml()
  -- get name of the icon for the sigil ("token" + lowercase name without space characters)
  local sigilName = ChaosBagApi.getReadableTokenName(sigil)
  local iconName  = "token-" .. (namesToIds[sigilName] or "custom-token")

  xmlSetter("Card_NkosiMabati_resolve_text", {
    textColor = "White",
    icon      = iconName,
    color     = TOKEN_COLOR[sigil],
    active    = isHelperEnabled and sigil ~= nil
  })
  xmlSetter("Card_NkosiMabati_reset_text", {
    textColor = "White",
    color     = TOKEN_COLOR[sigil],
    active    = isHelperEnabled and sigil ~= nil
  })
  xmlSetter("Card_NkosiMabati_choose_text", {
    textColor = "White",
    active    = isHelperEnabled and not sigil
  })
end

-- Create dialog window to choose sigil and create sigil-drawing button
function chooseSigil(player)
  player.clearSelectedObjects()

  -- get list of readable names
  local readableNames = {}
  for token, _ in pairs(TOKEN_COLOR) do
    table.insert(readableNames, ChaosBagApi.getReadableTokenName(token))
  end

  -- prompt player to choose sigil
  player.showOptionsDialog("Choose Sigil", readableNames, 1,
    function(chosenToken)
      sigil = ChaosBagApi.getChaosTokenName(chosenToken)
      updateSave()
      updateXml()
    end
  )
end

function xmlSetter(id, newAttributes)
  local currentAttributes = UI.getAttributes(id) or {}
  for k, v in pairs(newAttributes or {}) do
    currentAttributes[k] = v
  end
  self.UI.setAttributes(id, currentAttributes)
end

function resolveSigil()
  local match = false
  for _, obj in ipairs(ChaosBagApi.findChaosBag().getObjects()) do
    -- if there are any sigils in the bag
    if obj.nickname == sigil then
      match = true
      break
    end
  end

  if not match then
    broadcastToAll(ChaosBagApi.getReadableTokenName(sigil) .. " not found in chaos bag", "Red")
    return
  end

  ChaosBagApi.removeTokenFromPlay("redraw", VALID_TOKENS, nil, nil, sigil)
end
